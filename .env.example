# Safe, non-secret application defaults.
APP_NAME=ERPNext Agentic Platform
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Local caller identity for protected FastAPI business endpoints.
APP_PLATFORM_REQUESTER_ID=local-developer
# APP_PLATFORM_API_KEY=

# ERPNext connection metadata. These values are safe to document.
APP_ERPNEXT_BASE_URL=http://127.0.0.1:8000
APP_ERPNEXT_SITE_HOST=development.localhost
APP_ERPNEXT_EXPECTED_USER=agentic-api@jg-investors.test
APP_ERPNEXT_COMPANY=JG Investors (Demo)
APP_ERPNEXT_WAREHOUSE=Agentic Test Warehouse - JGD
APP_ERPNEXT_ITEM=AGENTIC-TEST-ITEM

# Copy this file to .env, then set credentials only in that ignored local file.
# APP_ERPNEXT_API_KEY=
# APP_ERPNEXT_API_SECRET=
